[Unit]
Description=Aegis protected local API
Requires=aegis-key.service aegis-witness.service aegis-attestor.service aegis-model@default.service
After=aegis-key.service aegis-witness.service aegis-attestor.service aegis-model@default.service
JoinsNamespaceOf=aegis-model@default.service

[Service]
Type=simple
User=aegis
Group=aegis
SupplementaryGroups=aegis-custody
WorkingDirectory=/opt/aegis
EnvironmentFile=/etc/aegis/runtime.env
Environment=AEGIS_SECURITY_PROFILE=production
Environment=AEGIS_DATA_DIR=/var/lib/aegis
Environment=AEGIS_KEY_BROKER_SOCKET=/run/aegis-key/service.sock
Environment=AEGIS_AUDIT_WITNESS_SOCKET=/run/aegis-witness/service.sock
Environment=AEGIS_ATTESTOR_SOCKET=/run/aegis-attestor/service.sock
ExecStart=/opt/aegis/.venv/bin/python /opt/aegis/run_aegis.py --host 127.0.0.1 --port 8000 --quiet
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
StateDirectory=aegis
StateDirectoryMode=0700
ReadWritePaths=/var/lib/aegis
InaccessiblePaths=/var/lib/aegis-key /var/lib/aegis-witness -/etc/aegis/attestor.private.pem -/var/run/docker.sock
LimitCORE=0
MemoryMax=2G
TasksMax=128
KillMode=control-group
TimeoutStopSec=15
Restart=no

[Install]
WantedBy=multi-user.target
